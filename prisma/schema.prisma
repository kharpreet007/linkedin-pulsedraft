generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Theme {
  PM
  AI
  Psychology
}

enum AssignmentStatus {
  Scheduled
  Published
}

/// One calendar day's pipeline output: Scout's 5 topics, Remy's drafts, Val's scores.
model Run {
  id        String   @id @default(cuid())
  date      String   @unique // YYYY-MM-DD, in PULSECRAFT_TIMEZONE
  createdAt DateTime @default(now())

  candidates      Candidate[]
  postedSelection PostedSelection?
  engagement      Engagement?
}

/// One of the day's 5 Scout topics, expanded by Remy into a full draft.
model Candidate {
  id      String  @id @default(cuid())
  runId   String
  run     Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  topic   String
  theme   Theme
  draft   String  @db.Text
  rank    Int? // 1-5, set once Val has scored & ranked all candidates for the run

  score           Score?
  postedSelection PostedSelection?

  @@index([runId])
}

/// Val's five-dimension score (0-10 each, 50 total) for one candidate.
model Score {
  id           String    @id @default(cuid())
  candidateId  String    @unique
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  hook         Int
  insight      Int
  authenticity Int
  engagement   Int
  clarity      Int
  total        Int
}

/// Which candidate was actually published for a given Run, plus any manual
/// topic/theme edits made after the fact (kept separate from the AI-generated
/// candidate fields so the original Scout/Remy/Val output is never overwritten).
model PostedSelection {
  id            String    @id @default(cuid())
  runId         String    @unique
  run           Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  candidateId   String    @unique
  candidate     Candidate @relation(fields: [candidateId], references: [id])
  topicOverride String?
  themeOverride Theme?
  postedAt      DateTime  @default(now())
}

/// Manually-entered LinkedIn metrics for a Run's published post (no LinkedIn API integration).
model Engagement {
  id          String   @id @default(cuid())
  runId       String   @unique
  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  impressions Int      @default(0)
  likes       Int      @default(0)
  comments    Int      @default(0)
  updatedAt   DateTime @updatedAt
}

/// A manually-curated, reusable topic idea in the Kanban planning pool. Purely a
/// planning tool — separate from Scout's own daily brainstorming, never feeds the
/// pipeline. The same idea can appear on many calendar days (see TopicAssignment),
/// so it carries no date or status of its own.
model TopicIdea {
  id        String   @id @default(cuid())
  title     String
  theme     Theme
  createdAt DateTime @default(now())

  assignments TopicAssignment[]
}

/// One calendar day's planned topic on the Kanban board. A single TopicIdea can
/// have many assignments (e.g. cycling through a small pool across a whole month),
/// but each date holds at most one assignment.
model TopicAssignment {
  id        String           @id @default(cuid())
  topicId   String
  topic     TopicIdea        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  date      String           @unique // YYYY-MM-DD
  status    AssignmentStatus @default(Scheduled)
  createdAt DateTime         @default(now())

  @@index([topicId])
}
