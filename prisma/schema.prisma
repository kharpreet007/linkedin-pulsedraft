generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Theme {
  PM
  AI
  Psychology
}

enum AssignmentStatus {
  Scheduled
  Published
}

/// Fixed set of business categories offered on the Kanban planning board —
/// intentionally broader than (and independent of) the Scout/Remy/Val pipeline's
/// own Theme enum, since this board is meant to work for any kind of content plan.
enum KanbanCategory {
  Business
  Logistics
  SupplyChain
  Transportation
  ProjectManagement
  ProductManagement
  GenAI
  Psychology
  Finance
}

/// One calendar day's pipeline output: Scout's 5 topics, Remy's drafts, Val's scores.
model Run {
  id        String   @id @default(cuid())
  date      String   @unique // YYYY-MM-DD, in PULSECRAFT_TIMEZONE
  createdAt DateTime @default(now())

  candidates      Candidate[]
  postedSelection PostedSelection?
  engagement      Engagement?
}

/// One of the day's 5 Scout topics, expanded by Remy into a full draft. Either `theme` (the
/// automatic daily pipeline's PM/AI/Psychology split) or `category` (a manually chosen Post Its
/// subject, used when generating for a specific calendar date) is set, never both. `sourceUrl`/
/// `sourceTitle` are set only when the topic was grounded in a real web article (e.g. an ingested
/// candidate from a web-search-backed generation) — null for anything drafted from general
/// knowledge, including every automatic daily-pipeline candidate.
model Candidate {
  id          String          @id @default(cuid())
  runId       String
  run         Run             @relation(fields: [runId], references: [id], onDelete: Cascade)
  topic       String
  theme       Theme?
  category    KanbanCategory?
  draft       String          @db.Text
  rank        Int? // 1-5, set once Val has scored & ranked all candidates for the run
  sourceUrl   String?
  sourceTitle String?

  score           Score?
  postedSelection PostedSelection?

  @@index([runId])
}

/// Val's five-dimension score (0-10 each, 50 total) for one candidate.
model Score {
  id           String    @id @default(cuid())
  candidateId  String    @unique
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  hook         Int
  insight      Int
  authenticity Int
  engagement   Int
  clarity      Int
  total        Int
}

/// Which candidate was actually published for a given Run, plus any manual
/// topic/theme edits made after the fact (kept separate from the AI-generated
/// candidate fields so the original Scout/Remy/Val output is never overwritten).
model PostedSelection {
  id            String    @id @default(cuid())
  runId         String    @unique
  run           Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  candidateId   String    @unique
  candidate     Candidate @relation(fields: [candidateId], references: [id])
  topicOverride String?
  themeOverride Theme?
  postedAt      DateTime  @default(now())
}

/// Manually-entered LinkedIn metrics for a Run's published post (no LinkedIn API integration).
model Engagement {
  id          String   @id @default(cuid())
  runId       String   @unique
  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  impressions Int      @default(0)
  likes       Int      @default(0)
  comments    Int      @default(0)
  updatedAt   DateTime @updatedAt
}

/// One calendar day's planned category on the Kanban board. Purely a planning
/// tool — separate from Scout's own daily brainstorming, never feeds the
/// pipeline. Generated by cycling through a set of selected categories evenly
/// across a chosen date range; each date holds at most one assignment.
model TopicAssignment {
  id        String           @id @default(cuid())
  category  KanbanCategory
  date      String           @unique // YYYY-MM-DD
  status    AssignmentStatus @default(Scheduled)
  createdAt DateTime         @default(now())
}

/// Generic single-value settings the app needs to remember but that don't warrant
/// their own table — e.g. the user's pre-tool posting baseline for Analytics.
model Setting {
  key   String @id
  value String
}
