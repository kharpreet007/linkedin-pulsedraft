# Postgres connection string (Neon / Vercel Postgres / Supabase all work).
# Needs to support Prisma migrations — a pooled + a direct URL is recommended on serverless hosts.
DATABASE_URL="postgresql://user:password@host:5432/pulsedraft?sslmode=require"

# Gemini API key used for Scout (Google Search-grounded topic discovery),
# Remy (draft generation) and Val (scoring). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="..."

# Model used for all three pipeline stages. Gemini model names rotate fairly often —
# check https://ai.google.dev/gemini-api/docs/models for the current list if this 404s.
GEMINI_MODEL="gemini-2.5-flash"

# Shared secret that must be sent as `Authorization: Bearer <value>` when calling /api/daily-run.
# Set the same value in your Vercel project's Cron secret (Vercel sends it automatically for scheduled crons
# once this env var exists) so only the scheduler — not the public internet — can trigger a real run.
CRON_SECRET="change-me-to-a-long-random-string"

# IANA timezone the daily run's "today" is computed in (affects the run's date key).
PULSECRAFT_TIMEZONE="America/New_York"
